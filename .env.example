# Copy to .env.local (not committed) and set the API the app calls. Required: npx expo start stops without it.
# iOS simulator, the API on this Mac:
EXPO_PUBLIC_API_URL=http://localhost:5186/api/v1
# A phone on the same Wi-Fi or the Android emulator: this Mac's IP (ipconfig getifaddr en0), e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5186/api/v1
# The API must listen on all interfaces for a phone (tasky-api launchSettings: http://*:5186).
# Builds for testers take it from eas.json instead (build.production.env).

# Optional. Development only: the API calls in the Metro terminal (npx expo start). all (default), errors, or off.
# EXPO_PUBLIC_HTTP_LOG=errors
