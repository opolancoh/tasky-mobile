{
  "expo": {
    "name": "Azignia",
    "slug": "azignia",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "azignia",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIDesignRequiresCompatibility": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ikobit.azignia",
      "icon": {
        "light": "src/assets/images/icon.png",
        "dark": "src/assets/images/icon-dark.png",
        "tinted": "src/assets/images/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.ikobit.azignia",
      "adaptiveIcon": {
        "foregroundImage": "src/assets/images/adaptive-icon.png",
        "monochromeImage": "src/assets/images/adaptive-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "src/assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "src/assets/images/notification-icon.png",
          "color": "#0B6BCB"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "31d01168-081b-4bce-a297-98288cb6e194"
      }
    },
    "owner": "opolancoh"
  }
}
