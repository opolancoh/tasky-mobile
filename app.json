{
  "expo": {
    "name": "Azignia",
    "slug": "azignia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "azignia",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIDesignRequiresCompatibility": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ikobit.azignia"
    },
    "android": {
      "package": "com.ikobit.azignia",
      "adaptiveIcon": {
        "foregroundImage": "src/assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "src/assets/images/splash-icon.png"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "31d01168-081b-4bce-a297-98288cb6e194"
      }
    },
    "owner": "opolancoh"
  }
}
